#!/usr/bin/env python3
"""Open MagicShelf's native SteamVR dashboard on SteamOS / Steam Frame."""
import subprocess
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from magicshelf.session import service_environment
env = service_environment()
subprocess.run(["systemctl", "--user", "start", "steamvr.service", "magicshelf.service", "magicshelf-vr.service"], env=env, check=True)
subprocess.run([str(Path(__file__).resolve().parent / "magicshelf-vr"), "--show"], env=env, check=True)
