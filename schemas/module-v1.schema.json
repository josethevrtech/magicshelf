{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/josethevrtech/magicshelf/main/schemas/module-v1.schema.json",
  "title": "MagicShelf module API v1",
  "type": "object",
  "required": [
    "schema_version",
    "api_version",
    "id",
    "version",
    "name",
    "description",
    "author",
    "license",
    "platform",
    "architecture",
    "entrypoint",
    "permissions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "api_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "const": "linux"
    },
    "architecture": {
      "enum": [
        "aarch64",
        "x86_64"
      ]
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "description": "Relative executable path; no empty, dot, parent, absolute or backslash components"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "vr-overlay",
          "network",
          "user-files"
        ]
      },
      "contains": {
        "const": "vr-overlay"
      }
    },
    "memory_mb": {
      "type": "integer",
      "minimum": 32,
      "maximum": 1024,
      "default": 256
    }
  },
  "additionalProperties": true
}
